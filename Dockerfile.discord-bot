FROM oven/bun:1-alpine

WORKDIR /app

COPY package.json /app/

COPY /discord-bot/package.json /app/discord-bot/

RUN mkdir /app/modules
COPY dashboard/package.json /app/dashboard/

COPY discord-bot /app/discord-bot

# Copy entrypoint script
COPY discord-bot/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Change ownership to user 1000 (bun user that already exists)
RUN chown -R 1000:1000 /app

USER 1000

EXPOSE 8080

ENTRYPOINT ["/app/docker-entrypoint.sh"]