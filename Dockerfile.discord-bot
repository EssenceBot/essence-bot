FROM oven/bun:1-alpine

# Create non-root user (reuse existing group 1000 if it exists)
RUN adduser -u 1000 -D -s /bin/sh essence

WORKDIR /app

COPY package.json /app/

COPY /discord-bot/package.json /app/discord-bot/

RUN mkdir /app/modules
COPY dashboard/package.json /app/dashboard/

RUN bun install --production

COPY discord-bot /app/discord-bot

# Change ownership to non-root user
RUN chown -R essence:essence /app

USER essence

EXPOSE 8080

CMD [ "bun", "run", "start:discord-bot" ]